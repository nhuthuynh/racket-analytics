# racket-analytics: environment contract for infra/compose.yaml (ST-001, AQS/OPS-01).
# Copy to infra/.env for local use:  cp infra/env.example infra/.env   (make env)
# Values here are DEV-ONLY placeholders. Real secrets live in the deployment secret store,
# never in the repo (NFR-056). Agents cannot write .env files (PreToolUse hook, ST-003).
#
# Compose fails fast when a required variable is missing; the API also refuses to start
# without them (ST-005 Settings).

# ---- runtime
APP_ENV=dev
LOG_LEVEL=INFO
# Dev/test identity provider (ST-006). The API must refuse APP_ENV=prod with this enabled.
DEV_IDENTITY_ENABLED=true

# ---- Postgres 16 (also the job queue, ADR 0008 part B)
POSTGRES_USER=racket
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=racket

# ---- S3-compatible object store: SeaweedFS in dev and CI (ADR 0008 part C)
S3_ACCESS_KEY_ID=racketdev
S3_SECRET_ACCESS_KEY=dev-only-s3-secret-key
S3_REGION=us-east-1
S3_BUCKET_MEDIA=racket-media

# ---- sign-in by email link (ST-013, ADR 0025, ADR 0027)
# Origin the sign-in link points at (the web app). https even in dev: the stack is served by the
# web-tls proxy (ADR 0029) so Secure `__Host-` cookies work in every browser. Staging/prod: the
# public https origin.
PUBLIC_WEB_ORIGIN=https://localhost:3000
# Origins allowed to send state-changing requests (POST/PUT/PATCH/DELETE) to the API; a request
# with any other Origin gets 403. Exactly the web origin, so a remapped web port carries it
# along (C-18, SEC-R5-S1-03). Comma-separated in staging/prod if there is more than one.
ALLOWED_ORIGINS=${PUBLIC_WEB_ORIGIN}
# Origin the API signs media links for (SRE-MEDIA, ST-037): the web origin, where web-tls
# serves /<bucket>/* from the store (presigned GET/HEAD only). Must come after PUBLIC_WEB_ORIGIN.
S3_PUBLIC_ENDPOINT_URL=${PUBLIC_WEB_ORIGIN}
MAIL_FROM=no-reply@localhost
# HMAC key for email pseudonyms in logs and rate limits. DEV-ONLY placeholder; staging/prod
# need their own value (>= 32 characters) from the secret store and refuse to start without it.
AUTH_EMAIL_KEY=dev-only-email-key-not-a-secret-0000

# ---- tracing (OpenTelemetry OTLP/HTTP into Jaeger; AQS/OPS-06)
OTEL_TRACES_SAMPLER=parentbased_always_on

# ---- web
PUBLIC_API_BASE_URL=http://localhost:8000
# Path prefix the browser uses to reach the API (the web's /api rewrite). The API puts it in
# the tus Location header, so it must match the rewrite: /api. Empty only in backend tests.
API_PUBLIC_PATH_PREFIX=/api

# ---- host ports (all bound to 127.0.0.1)
POSTGRES_HOST_PORT=5432
S3_HOST_PORT=8333
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025
# API port for server-side measurement only (G02-04). The per-IP sign-in limit (T-ML-8) holds
# only behind web-tls (https://localhost:3000): on this port a caller sets its own
# X-Forwarded-For (C-11, SEC-R6-S1-02).
API_HOST_PORT=8000
# https://localhost:3000 via web-tls (ADR 0029); the web container itself is not published.
WEB_HOST_PORT=3000
TRACING_UI_HOST_PORT=16686

# ---- image registry for Docker Hub images (set to mirror.gcr.io if Docker Hub rate-limits)
DOCKERHUB_REGISTRY=docker.io
