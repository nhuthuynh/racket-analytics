# racket-analytics: environment contract for infra/compose.yaml (ST-001, AQS/OPS-01).
# Copy to infra/.env for local use:  cp infra/env.example infra/.env   (make env)
# Values here are DEV-ONLY placeholders. Real secrets live in the deployment secret store,
# never in the repo (NFR-056). Agents cannot write .env files (PreToolUse hook, ST-003).
#
# Compose fails fast when a required variable is missing; the API also refuses to start
# without them (ST-005 Settings).

# ---- runtime
APP_ENV=dev
LOG_LEVEL=INFO
# Dev/test identity provider (ST-006). The API must refuse APP_ENV=prod with this enabled.
DEV_IDENTITY_ENABLED=true

# ---- Postgres 16 (also the job queue, ADR 0008 part B)
POSTGRES_USER=racket
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=racket

# ---- S3-compatible object store: SeaweedFS in dev and CI (ADR 0008 part C)
S3_ACCESS_KEY_ID=racketdev
S3_SECRET_ACCESS_KEY=dev-only-s3-secret-key
S3_REGION=us-east-1
S3_BUCKET_MEDIA=racket-media
# Host-visible endpoint used when signing URLs for the browser (tus/presigned GET).
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333

# ---- tracing (OpenTelemetry OTLP/HTTP into Jaeger; AQS/OPS-06)
OTEL_TRACES_SAMPLER=parentbased_always_on

# ---- web
PUBLIC_API_BASE_URL=http://localhost:8000

# ---- host ports (all bound to 127.0.0.1)
POSTGRES_HOST_PORT=5432
S3_HOST_PORT=8333
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025
API_HOST_PORT=8000
WEB_HOST_PORT=3000
TRACING_UI_HOST_PORT=16686

# ---- image registry for Docker Hub images (set to mirror.gcr.io if Docker Hub rate-limits)
DOCKERHUB_REGISTRY=docker.io
