# The `obs` overlay (ST-075b; ADR 0057 §3; docs/ops/sli-metrics.md). Append to infra/.env:
#   cat infra/observability/obs.env >> infra/.env && make up
# Starts otel-collector and prometheus (http://127.0.0.1:9090), points the API and the purge at
# the collector, and runs the purge every 5 min so the upload alerts see each run's expirations.
COMPOSE_PROFILES=obs
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
PURGE_INTERVAL_S=300
